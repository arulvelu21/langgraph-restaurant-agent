# Which LLM provider to use: groq | openrouter | anthropic
AGENT_PROVIDER=groq

# Set the key for the provider you picked
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# AGENT_MODEL=openai/gpt-oss-120b
# AGENT_MAX_TOKENS=8000

# Persistent memory (start it with: docker compose up -d). Remove to use in-memory.
DATABASE_URL=postgresql://agent:agent@localhost:5434/agent

# Restaurant finder: Google Places API (New) key
# https://console.cloud.google.com/apis/credentials  (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=

# Where "near me" searches look (lat,lng), unless the user has saved a home area
# ("I live in Gunjur, Bangalore"). Right-click a spot in Google Maps to copy it.
# DEFAULT_LOCATION=12.9716,77.5946
# How far "near me" reaches, in metres
# SEARCH_RADIUS_M=5000
